# AVCI Gerüstbau – Serverkonfiguration für Apache (ALL-INKL)
#
# ACHTUNG vor dem Hochladen lesen:
# Der HTTPS-Block unten leitet jeden Aufruf auf https:// um. Wenn für die Domain
# noch KEIN SSL-Zertifikat eingerichtet ist, ist die Seite danach nicht mehr
# erreichbar. Im KAS zuerst unter "Domain" → SSL-Schutz das kostenlose
# Let's-Encrypt-Zertifikat aktivieren, ein paar Minuten warten, testen –
# und erst dann diesen Block aktiv lassen.

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS erzwingen (siehe Hinweis oben) ---
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Eine einzige kanonische Adresse: www entfernen ---
  # Ohne das ist die Seite unter zwei Adressen erreichbar und Suchmaschinen
  # verteilen die Bewertung auf beide.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Komprimierung: spart bei der HTML-Datei rund zwei Drittel ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Zwischenspeicher im Browser ---
# Fotos und Logo ändern sich praktisch nie, die HTML-Datei dagegen bei jeder
# Textänderung – die darf deshalb nicht zwischengespeichert werden.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- Ein paar Schutz-Kopfzeilen ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
