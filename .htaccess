# AVCI Gerüstbau – Serverkonfiguration für Apache (ALL-INKL)
#
# Kanonische Adresse ist https://www.avci-geruestbau.de
#
# Warum www und nicht ohne: Die Domain lag beim Einrichten mit www bereits auf
# dem ALL-INKL-Server samt gültigem Zertifikat, während avci-geruestbau.de ohne
# www noch auf den alten Anbieter zeigte. Eine Weiterleitung auf ohne-www hätte
# die Besucher auf die alte Platzhalterseite geschickt.

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Alles in EINEM Sprung auf https://www ---
  # Bewusst eine einzige Regel: Ein Aufruf von http://avci-geruestbau.de landet
  # damit direkt auf https://www... Zwei getrennte Regeln würden erst auf
  # https://avci-geruestbau.de umleiten – und dort warnt der Browser, solange
  # das Zertifikat nur für www gilt.
  # Die erste Bedingung greift nur für die echte Domain, damit die
  # kasserver.com-Testadresse weiter direkt erreichbar bleibt.
  RewriteCond %{HTTP_HOST} avci-geruestbau\.de$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.avci-geruestbau.de%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Komprimierung: spart bei der HTML-Datei rund zwei Drittel ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Zwischenspeicher im Browser ---
# Fotos und Logo ändern sich praktisch nie, die HTML-Datei dagegen bei jeder
# Textänderung – die darf deshalb nicht zwischengespeichert werden.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- Ein paar Schutz-Kopfzeilen ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
